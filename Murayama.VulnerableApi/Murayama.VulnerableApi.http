############################################################
# OWASP API6 - SERVER-SIDE REQUEST FORGERY (SSRF)
############################################################

# ---------------------------------------------------------
# Vulnerable
# ---------------------------------------------------------

### API7 - Vulnerable - Fetch internal resource

POST {{host}}/api/vulnerable/fetch
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "url": "http://localhost:5248/api/internal/metadata"
}

###

# ---------------------------------------------------------
# Secure
# ---------------------------------------------------------

### API7 - Secure - Internal resource blocked

POST {{host}}/api/secure/fetch
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "url": "http://localhost:5248/api/internal/metadata"
}

###

############################################################
# OWASP API8 - SECURITY MISCONFIGURATION
############################################################

# ---------------------------------------------------------
# Vulnerable
# ---------------------------------------------------------

### API8 - Vulnerable - Internal error details exposed

GET {{host}}/api/vulnerable/diagnostics/error
Accept: application/json
Authorization: Bearer {{token}}

###

# ---------------------------------------------------------
# Secure
# ---------------------------------------------------------

### API8 - Secure - Internal error details hidden

GET {{host}}/api/secure/diagnostics/error
Accept: application/json
Authorization: Bearer {{token}}

###

############################################################
# OWASP API9 - IMPROPER INVENTORY MANAGEMENT
############################################################

# ---------------------------------------------------------
# Vulnerable
# ---------------------------------------------------------

### API9 - Legacy v1 - Deprecated endpoint still accessible

GET {{host}}/api/v1/users
Accept: application/json

###

# ---------------------------------------------------------
# Secure
# ---------------------------------------------------------

### API9 - Current v2 - Alice denied

GET {{host}}/api/v2/users
Accept: application/json
Authorization: Bearer {{token}}

###

### API9 - Current v2 - Admin allowed

GET {{host}}/api/v2/users
Accept: application/json
Authorization: Bearer {{adminToken}}

###