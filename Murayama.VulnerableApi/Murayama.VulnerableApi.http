############################################################
# OWASP API3 - BROKEN OBJECT PROPERTY LEVEL AUTHORIZATION
############################################################

# ----------------------------------------------------------
# Vulnerable - Excessive Data Exposure
# ----------------------------------------------------------

### API3 - Excessive Data Exposure - Vulnerable

GET {{host}}/api/vulnerable/users/me
Accept: application/json
Authorization: Bearer {{token}}

###

### API3 - Excessive Data Exposure - Secure

GET {{host}}/api/secure/users/me
Accept: application/json
Authorization: Bearer {{token}}

###

### API3 - Mass Assignment - Vulnerable

PUT {{host}}/api/vulnerable/users/me
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Alice",
  "email": "alice@murayama.local",
  "role": "Admin",
  "passwordHash": "ignored-by-this-endpoint"
}

###

### API3 - Mass Assignment - Secure

PUT {{host}}/api/secure/users/me
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Alice Secure",
  "email": "alice@murayama.local",
  "role": "Admin"
}

###

############################################################
# OWASP API4 - UNRESTRICTED RESOURCE CONSUMPTION
############################################################

# ---------------------------------------------------------
# Vulnerable - Unrestricted Pagination
# ---------------------------------------------------------

### API4 - Vulnerable - Normal Page Size

GET {{host}}/api/vulnerable/orders/search?page=1&pageSize=20
Accept: application/json
Authorization: Bearer {{token}}

###

### API4 - Vulnerable - Excessive Page Size

GET {{host}}/api/vulnerable/orders/search?page=1&pageSize=1000000
Accept: application/json
Authorization: Bearer {{token}}

###

### API4 - Secure - Normal Page Size

GET {{host}}/api/secure/orders/search?page=1&pageSize=20
Accept: application/json
Authorization: Bearer {{token}}

###

### API4 - Secure - Excessive Page Size

GET {{host}}/api/secure/orders/search?page=1&pageSize=1000000
Accept: application/json
Authorization: Bearer {{token}}

###

############################################################
# OWASP API5 - BROKEN FUNCTION LEVEL AUTHORIZATION
############################################################

# ----------------------------------------------------------
# Vulnerable
# ----------------------------------------------------------

### API5 - Vulnerable - Alice accesses admin function

GET {{host}}/api/vulnerable/admin/users
Accept: application/json
Authorization: Bearer {{token}}

###

# ----------------------------------------------------------
# Secure
# ----------------------------------------------------------

### API5 - Secure - Alice denied admin function

GET {{host}}/api/secure/admin/users
Accept: application/json
Authorization: Bearer {{token}}

###

### API5 - Secure - Admin accesses admin function

GET {{host}}/api/secure/admin/users
Accept: application/json
Authorization: Bearer {{adminToken}}

###

